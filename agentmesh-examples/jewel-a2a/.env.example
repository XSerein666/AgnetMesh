# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jewel_a2a
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# 阿里云 DashScope API Key
DASHSCOPE_API_KEY=your_api_key_here
# ============================================
# Jewel-A2A 环境变量配置模板
# 复制此文件为 .env 并填入真实值
#   cp .env.example .env
# ============================================

# 数据库（PostgreSQL + pgvector）
DB_PASSWORD=123456

# DashScope API Key（阿里云灵积）
DASHSCOPE_API_KEY=

# OpenAI API Key（可选）
OPENAI_API_KEY=

# DeepSeek API Key（可选）
DEEPSEEK_API_KEY=

# 工具市场密钥
MARKETPLACE_PUBLISHER_KEY=change-me
MARKETPLACE_ADMIN_KEY=change-me
MARKETPLACE_INTERNAL_TOKEN=change-me

# Agent 间认证密钥
AGENT_AUTH_API_KEY=change-me